# Источники и ключи используются только сервером. Этот файл-пример не загружается автоматически.
GOAL_API_KEY=replace_with_your_private_goal_key
API_FOOTBALL_API_KEY=replace_with_your_private_api_football_key
GOAL_RPL_SEASON=2026
GOAL_RPL_LEAGUE_ID=cmr77dvua00a4rx061d2jre7p

# Основной календарный источник. Требуется Python 3.9+; proxy sidecar запускается npm start.
RPL_FLASHSCORE_ENABLED=true
RPL_FLASHSCORE_AUTOSTART=true
RPL_FLASHSCORE_PROXY_URL=http://127.0.0.1:8765

PORT=4173
HOST=127.0.0.1
# Optional persistent directory outside the application release.
KROMKA_CACHE_DIR=

# Публичные параметры релиза. Заполняются после выбора российского хостинга.
# Влияют на тексты документов и индексирование; это не настройка серверов провайдера.
APP_PUBLIC_URL=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_COUNTRY=RU
LEGAL_HOSTING_LOCATION=
# Укажите фактический срок, настроенный у выбранного хостинга, а не желаемое число.
LEGAL_LOG_RETENTION_DAYS=
# Почтовый адрес для юридически значимых обращений, если используется.
LEGAL_POSTAL_ADDRESS=
